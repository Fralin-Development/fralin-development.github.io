<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp 
          xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" 
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
          xsi:type="ContentApp">
  <Id>c851a011-3a61-4c9e-bd2d-35344484291c</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>The Fralin Museum of Art</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Fralin Live Donor Roll" />
  <Description DefaultValue="Embeds the live scrolling Fralin Museum of Art donor recognition roll directly onto PowerPoint slides." />
  <IconUrl DefaultValue="https://fralin-development.github.io/favicon.png" />
  <HighResolutionIconUrl DefaultValue="https://fralin-development.github.io/logo-TF-icon_0.png" />
  <SupportUrl DefaultValue="https://github.com/Fralin-Development/fralin-development.github.io" />
  <AppDomains>
    <AppDomain>https://fralin-development.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation" />
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://fralin-development.github.io/?embed=true" />
    <RequestedWidth>960</RequestedWidth>
    <RequestedHeight>600</RequestedHeight>
  </DefaultSettings>
  <Permissions>Restricted</Permissions>
</OfficeApp>
